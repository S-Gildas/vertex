{
  "name": "vertex",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["web", "studio"],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:studio": "npm run dev --workspace studio",
    "build": "npm run build --workspace studio && npm run build --workspace web",
    "build:web": "npm run build --workspace web",
    "build:studio": "npm run build --workspace studio",
    "seed": "npm run seed --workspace studio",
    "seed:build": "npm run seed:build --workspace studio",
    "seed:dry-run": "npm run seed:dry-run --workspace studio",
    "seed:validate": "npm run seed:validate --workspace studio",
    "seed:backup": "npm run seed:backup --workspace studio",
    "seed:preflight": "npm run seed:preflight --workspace studio",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace studio && npm run typecheck --workspace web",
    "typegen": "npm run schema:extract --workspace studio && npm run typegen --workspace studio"
  }
}
